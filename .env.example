# ヘヤカルテ（Next.js 版）の環境変数の見本。手元では .env.local に、本番は Vercel の Environment Variables に入れる
# どれも入れなければ、ログイン・同期・物件の管理・AI は出ず、ひな形のまま動く

# Postgres の接続先（本番は Vercel の Storage から作れる Neon など）
# 手元の例：docker run -d --name heyakarte-db -e POSTGRES_USER=heyakarte -e POSTGRES_PASSWORD=heyakarte-local -e POSTGRES_DB=heyakarte -p 127.0.0.1:5439:5432 postgres:17-alpine
DATABASE_URL=postgres://heyakarte:heyakarte-local@127.0.0.1:5439/heyakarte

# ログインの Cookie に署名する鍵（32文字以上のランダムな文字列）。作り方：openssl rand -base64 48
AUTH_SECRET=

# 親への相談文の AI（任意）
ANTHROPIC_API_KEY=

# ヘヤまるのヒアリングで、答えと自由に書いた文から重みを決める Gemini API（任意。ログインした人だけが使う）
# 無いときは、選んだ答えから決まりに沿って重みを決める
GEMINI_API_KEY=
# 使うモデル（省略すると gemini-3.5-flash-lite）
GEMINI_MODEL=
